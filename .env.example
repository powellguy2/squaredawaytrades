# Copy this file to .env.local and fill in every value below.
# None of these may be prefixed NEXT_PUBLIC_ — that prefix ships the value
# into the browser bundle, which would leak the service role key. See
# CLAUDE.md "Security posture" before changing anything here.

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=

# Supabase > Project Settings > API Keys > service_role (secret, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the /admin signup list. Generate with: openssl rand -base64 32
ADMIN_TOKEN=

# Salt for hashing signup IPs before storage. Generate with: openssl rand -base64 32
IP_HASH_SALT=
